# ── LLM ──────────────────────────────────────────────────────────────────
# Model to use (any LiteLLM-compatible string)
THEORYCRAFT_MODEL=claude-sonnet-4-6

# Provider API keys — set whichever matches your model
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ── Langfuse Telemetry ────────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# Cloud (default) — or set to your self-hosted URL
LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_HOST=http://localhost:3000

# ── GitHub Integration ────────────────────────────────────────────────────
# PAT mode (default)
GITHUB_TOKEN=ghp_...

# GitHub App mode (optional — takes precedence if both set)
# GITHUB_APP_ID=123456
# GITHUB_APP_PRIVATE_KEY_PATH=/path/to/private-key.pem

# Default GitHub org for new repo creation (optional)
# GITHUB_ORG=myorg

# ── Notifications ─────────────────────────────────────────────────────────
# Slack incoming webhook URL
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Generic HTTP webhook (POST)
# GENERIC_WEBHOOK_URL=https://myapp.com/webhooks/theorycraft

# ── Session & Output ──────────────────────────────────────────────────────
# Where SQLite session files are stored (default: ~/.theorycraft/sessions)
# THEORYCRAFT_SESSIONS_DIR=~/.theorycraft/sessions

# Default output directory for product.json files
# THEORYCRAFT_OUTPUT_DIR=./output

# ── Graph Limits ──────────────────────────────────────────────────────────
# Max clarification rounds before forcing to ideation
THEORYCRAFT_MAX_CLARIFY_ROUNDS=2

# Max revision cycles before forcing spec assembly
THEORYCRAFT_MAX_REVISIONS=3
