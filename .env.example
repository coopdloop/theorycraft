# ── LLM ──────────────────────────────────────────────────────────────────
# Model to use (any LiteLLM-compatible string)
THEORYCRAFT_MODEL=claude-sonnet-4-6

# Provider API keys — set whichever matches your model
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ── Langfuse Telemetry (optional) ────────────────────────────────────────
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...

# Cloud (default) — or set to your self-hosted URL
LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_HOST=http://localhost:3000

# ── GitHub Integration ────────────────────────────────────────────────────
# PAT mode (default)
GITHUB_TOKEN=ghp_...

# GitHub App mode (optional — takes precedence if both set)
# GITHUB_APP_ID=123456
# GITHUB_APP_PRIVATE_KEY_PATH=/path/to/private-key.pem

# Default GitHub org for new repo creation (optional)
# GITHUB_ORG=myorg

# ── Slack Bot (interactive, Socket Mode) ─────────────────────────────────
# Create an app at https://api.slack.com/apps — enable Socket Mode.
# Bot token scopes needed: app_mentions:read, channels:history, chat:write, groups:history, im:history
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...    (Socket Mode app-level token — starts with xapp-)

# ── Notifications (outbound webhook only) ─────────────────────────────────
# Slack incoming webhook URL
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Generic HTTP webhook (POST)
# GENERIC_WEBHOOK_URL=https://myapp.com/webhooks/theorycraft

# ── Session & Output ──────────────────────────────────────────────────────
# Where SQLite session files are stored (default: ~/.theorycraft/sessions)
# THEORYCRAFT_SESSIONS_DIR=~/.theorycraft/sessions

# Default output directory for product.json files
# THEORYCRAFT_OUTPUT_DIR=./output

# GitHub repo to archive completed specs into — e.g. "coopdloop/theorycraft"
# Sessions are committed to sessions/<session-name>/product.json
# THEORYCRAFT_ARCHIVE_REPO=coopdloop/theorycraft

# ── Graph Limits ──────────────────────────────────────────────────────────
# Max clarification rounds before forcing to ideation
THEORYCRAFT_MAX_CLARIFY_ROUNDS=2

# Max revision cycles before forcing spec assembly
THEORYCRAFT_MAX_REVISIONS=3
